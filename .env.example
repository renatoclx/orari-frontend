# Copie para .env.local e ajuste os valores.

# Endereço do backend (NestJS). Usado só no servidor do Next.
API_URL=http://localhost:3333

# Só em desenvolvimento: "off" libera as rotas sem login. Em produção é
# ignorada (NODE_ENV=production), e nunca deve ser definida no servidor.
# AUTH_GUARD=off
